# Jarvis 2.0 Configuration
# Copy this file to .env and fill in your values

# --- LLM Provider ---
# Using Gemini (Recommended - free tier is generous)
GEMINI_API_KEY=your_gemini_api_key_here

# Using Groq (Alternative - also free tier)
# GROQ_API_KEY=your_groq_api_key_here

# --- Weather API ---
# Get a free key from https://openweathermap.org/
OPENWEATHER_API_KEY=your_openweather_api_key_here
DEFAULT_CITY=Kolkata

# --- STT Settings ---
# Model options: tiny, base, small, medium (larger = slower but more accurate)
WHISPER_MODEL=base

# --- Wake Word ---
# Options: hey_jarvis, alexa, ok_google (see openwakeword models)
WAKE_WORD_MODEL=hey_jarvis

# --- TTS Settings ---
# Edge-TTS voice. Examples: en-IN-NeerjaNeural, en-US-GuyNeural
TTS_VOICE=en-IN-NeerjaNeural

# --- Security ---
# Commands that require confirmation before execution
CONFIRM_COMMANDS=delete,remove,send,email,shutdown
